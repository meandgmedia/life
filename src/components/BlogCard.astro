---
type Props = {
  title: string;
  description: string;
  publishDate: Date;
  href: string;
};

const { title, description, publishDate, href } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class="blog-card" href={href}>
  <span class="blog-card__date">{formattedDate}</span>
  <h2 class="blog-card__title">{title}</h2>
  <p class="blog-card__desc">{description}</p>
  <span class="blog-card__link" aria-hidden="true">
    Read the article
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    height: 100%;
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .blog-card:hover {
    border-color: var(--color-teal);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .blog-card__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .blog-card__title {
    font-size: 1.2rem;
    margin: 0;
  }

  .blog-card__desc {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    flex: 1;
    max-width: none;
  }

  .blog-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-teal-dark);
  }

  .blog-card__link svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .blog-card:hover .blog-card__link svg {
    transform: translateX(3px);
  }
</style>
