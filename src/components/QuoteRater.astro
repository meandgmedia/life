---
// ============================================================================
// QuoteRater.astro
// Reusable container for the BackNine Insurance Quote & Apply embed.
//
// HOW TO ADD THE REAL EMBED (drop-in, no other changes needed):
//   1. Delete the <div class="quote-rater__skeleton">...</div> block below.
//   2. Paste your real BackNine embed code (script tag + widget container,
//      iframe, or div — whatever BackNine gives you) in its place, between
//      the BACKNINE EMBED START / END comments.
//   3. That's it. The card, border, shadow, spacing, and responsive sizing
//      around it are already built and already match the rest of the site —
//      you don't need to touch this component's markup or styles.
//
// This component can be reused anywhere a quote experience is needed later
// (homepage, final expense page, term/whole life pages) — just drop
// <QuoteRater /> in and the same embed renders inside matching styling.
// ============================================================================
type Props = {
  /** Optional small label above the embed, e.g. "Step 1 of 2". Omit if not needed. */
  label?: string;
};

const { label } = Astro.props;
---

<div class="quote-rater">
  {label && <p class="quote-rater__label">{label}</p>}

  <!-- BACKNINE EMBED START -->
  <div class="quote-rater__skeleton" role="status" aria-live="polite">
    <span class="visually-hidden">Loading your quote experience…</span>
    <div class="quote-rater__skeleton-bar quote-rater__skeleton-bar--wide" aria-hidden="true"></div>
    <div class="quote-rater__skeleton-row" aria-hidden="true">
      <div class="quote-rater__skeleton-bar"></div>
      <div class="quote-rater__skeleton-bar"></div>
    </div>
    <div class="quote-rater__skeleton-bar quote-rater__skeleton-bar--wide" aria-hidden="true"></div>
    <div class="quote-rater__skeleton-button" aria-hidden="true"></div>
  </div>
  <!-- BACKNINE EMBED END -->
</div>

<style>
  .quote-rater {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    min-height: 420px;
  }

  .quote-rater__label {
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-teal-dark);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }

  /* Skeleton loader — stands in for the embed so the page never looks
     unfinished. Replace this block per the instructions above. */
  .quote-rater__skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 520px;
    margin-inline: auto;
    padding-block: var(--space-6);
  }

  .quote-rater__skeleton-bar,
  .quote-rater__skeleton-button {
    border-radius: var(--radius-sm);
    background: linear-gradient(
      100deg,
      var(--color-cloud) 30%,
      var(--color-ink-tint) 50%,
      var(--color-cloud) 70%
    );
    background-size: 200% 100%;
    animation: quote-rater-shimmer 1.8s ease-in-out infinite;
  }

  .quote-rater__skeleton-bar {
    height: 3rem;
  }

  .quote-rater__skeleton-bar--wide {
    height: 3.5rem;
  }

  .quote-rater__skeleton-row {
    display: flex;
    gap: var(--space-4);
  }

  .quote-rater__skeleton-row .quote-rater__skeleton-bar {
    flex: 1;
  }

  .quote-rater__skeleton-button {
    height: 3.25rem;
    border-radius: var(--radius-full);
    margin-top: var(--space-2);
  }

  @keyframes quote-rater-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-rater__skeleton-bar,
    .quote-rater__skeleton-button {
      animation: none;
      background: var(--color-cloud);
    }
  }
</style>
