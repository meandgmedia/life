---
// ============================================================================
// QuoteRater.astro
// Container for the live BackNine ("Strife") Quote & Apply embed.
//
// IMPORTANT — this component renders the vendor's exact snippet, including
// its fixed element IDs (id="container-id" and id="strife" on the script
// tag). BackNine's widget script targets those IDs directly, so:
//   - Don't render <QuoteRater /> more than once on the same page — a
//     second copy would duplicate those IDs and the widget will not
//     initialize twice correctly.
//   - It's fine to use <QuoteRater /> once each on multiple different
//     pages (e.g. once on the homepage, once on /get-a-quote/) — each page
//     load only ever has one copy in its own DOM.
// ============================================================================
type Props = {
  /** Optional small label above the embed, e.g. "Step 1 of 2". Omit if not needed. */
  label?: string;
};

const { label } = Astro.props;
---

<div class="quote-rater">
  {label && <p class="quote-rater__label">{label}</p>}

  <!-- BACKNINE EMBED START -->
  <div id="container-id"></div>
  <script
    is:inline
    id="strife"
    src="https://cdn.quoteandapply.io/widget.js"
    data-strife-key="4Aa0Ad1Np-TT7xVC"
    data-strife-container-id="container-id"></script>
  <!-- BACKNINE EMBED END -->
</div>

<style>
  .quote-rater {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    min-height: 420px;
  }

  .quote-rater__label {
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-teal-dark);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }
</style>
