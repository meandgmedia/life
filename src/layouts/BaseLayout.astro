---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import '../styles/global.css';
import type { SeoProps } from '../lib/seo';
import { SITE } from '../data/site';

type Props = SeoProps;

const seoProps = Astro.props;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.domain}/#organization`,
      name: SITE.name,
      url: SITE.domain,
      logo: new URL('/og-default.jpg', SITE.domain).toString(),
      ...(Object.values(SITE.social).some(Boolean)
        ? { sameAs: Object.values(SITE.social).filter(Boolean) }
        : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.domain}/#website`,
      url: SITE.domain,
      name: SITE.name,
      publisher: { '@id': `${SITE.domain}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e2238" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZYR67Z5YH0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-ZYR67Z5YH0');
    </script>

    <!-- Fonts: preconnect + swap so type never blocks first paint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <SEO {...seoProps} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA />
  </body>
</html>
