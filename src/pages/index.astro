---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import QuoteRater from '../components/QuoteRater.astro';
import HowItWorks from '../components/HowItWorks.astro';
import InsuranceTypeCard from '../components/InsuranceTypeCard.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { coverageTypes } from '../data/coverageTypes';
import { homepageFaq } from '../data/faq';
import { RELATED_SITES } from '../data/site';

const steps = [
  {
    title: 'Get Your Quote',
    description: 'Tell us about yourself and the coverage you\u2019re looking for.',
  },
  {
    title: 'Compare Your Options',
    description: 'Review available coverage options based on your information.',
  },
  {
    title: 'Apply & Get Covered',
    description: 'Complete your application online and, if approved and eligible, obtain coverage.',
  },
];

const trustPoints = [
  {
    title: 'Florida-Focused',
    description: 'Built specifically around the coverage options available to Florida residents.',
  },
  {
    title: 'Online Quote Convenience',
    description: 'Request a personalized quote and compare options from your phone or computer, on your schedule.',
  },
  {
    title: 'Multiple Coverage Options',
    description: 'Explore term, whole, universal, final expense, and senior life coverage in one place.',
  },
  {
    title: 'Simple Application Process',
    description: 'A straightforward path from quote to application, designed to be easy to follow.',
  },
  {
    title: 'Personalized Options',
    description: 'The coverage options you see are based on the information you provide.',
  },
  {
    title: 'Educational Resources',
    description: 'Plain-language guides to help you understand your options before you apply.',
  },
];
---

<BaseLayout
  title="Florida Life Insurance | Life Insurance Made Simple."
  description="Compare life insurance options available in Florida and get your personalized quote online. Term, whole, universal, final expense, and senior life coverage."
  path="/"
>
  <!-- HERO -->
  <section class="hero section">
    <svg class="hero__wave" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 120C240 60 480 180 720 120C960 60 1200 180 1440 120V200H0V120Z" fill="var(--color-ink-tint)"/>
    </svg>
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">Florida &middot; Life Insurance</span>
        <h1>Life Insurance Made Simple.</h1>
        <p class="lead">
          Explore life insurance options available in Florida, compare coverage,
          and get your personalized quote online.
        </p>
        <div class="hero__actions">
          <Button href="/get-a-quote/" variant="primary" size="lg">Get My Free Quote</Button>
          <Button href="/life-insurance/" variant="secondary" size="lg">Explore Life Insurance</Button>
        </div>
      </div>

      <!-- Signature visual: a stylized quote-flow mockup, not stock photography -->
      <div class="quote-mock" aria-hidden="true">
        <div class="quote-mock__header">
          <span class="quote-mock__dot"></span>
          <span class="quote-mock__dot"></span>
          <span class="quote-mock__dot"></span>
        </div>
        <div class="quote-mock__field">
          <span class="quote-mock__label">Coverage Amount</span>
          <span class="quote-mock__value">$250,000</span>
        </div>
        <div class="quote-mock__row">
          <div class="quote-mock__field quote-mock__field--half">
            <span class="quote-mock__label">ZIP Code</span>
            <span class="quote-mock__value">32901</span>
          </div>
          <div class="quote-mock__field quote-mock__field--half">
            <span class="quote-mock__label">Date of Birth</span>
            <span class="quote-mock__value">01 / 15 / 1985</span>
          </div>
        </div>
        <div class="quote-mock__cta">See My Options</div>
        <div class="quote-mock__footnote">Estimated options &middot; no obligation</div>
      </div>
    </div>
  </section>

  <!-- LIVE QUOTE -->
  <section class="section section--cloud">
    <div class="container container--narrow">
      <SectionHeading
        eyebrow="Get a Quote"
        title="See your options in minutes"
        lead="Answer a few questions to compare the life insurance coverage available to you \u2014 no obligation."
        align="center"
      />
      <div style="margin-top: var(--space-8);">
        <QuoteRater />
      </div>
      <p class="quote-disclosure">
        Coverage is subject to eligibility and underwriting. Product
        availability and pricing vary by carrier and applicant. Some
        policies may be issued quickly depending on eligibility and carrier
        underwriting.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="How It Works"
        title="From quote to coverage in three steps"
        lead="A straightforward path, designed around the way people actually shop for life insurance today."
      />
      <div style="margin-top: var(--space-8);">
        <HowItWorks steps={steps} />
      </div>
    </div>
  </section>

  <!-- LIFE INSURANCE TYPES -->
  <section class="section section--cloud">
    <div class="container">
      <SectionHeading
        eyebrow="Coverage Options"
        title="Explore your life insurance options"
        lead="Every family and budget is different. Here are the major types of life insurance available to Florida residents."
      />
      <div class="grid grid--4" style="margin-top: var(--space-8);">
        {coverageTypes.map((type) => (
          <InsuranceTypeCard {...type} />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL EXPENSE & SENIOR LIFE SPOTLIGHT -->
  <section class="section fe-spotlight">
    <div class="container">
      <SectionHeading
        eyebrow="Final Expense & Senior Life"
        title="Coverage built around funeral, burial, and final expenses"
        lead="Final expense and senior life insurance are among the most common ways Floridians protect their families from unexpected end-of-life costs."
      />

      <div class="fe-spotlight__grid">
        <div class="fe-spotlight__card">
          <h3>Final Expense &amp; Burial Insurance</h3>
          <p>
            Final expense insurance (sometimes called burial or funeral insurance) is
            designed to help cover funeral, burial, cremation, and other end-of-life
            costs. Coverage amounts are typically smaller than traditional life
            insurance, and many products are simplified issue, with fewer health
            questions than fully underwritten policies.
          </p>
          <a class="fe-spotlight__link" href="/final-expense-insurance/">Learn about final expense insurance →</a>
        </div>

        <div class="fe-spotlight__card">
          <h3>Senior Life Insurance</h3>
          <p>
            Life insurance options for older adults vary based on age, health, and
            the type of coverage you're looking for. Some seniors qualify for
            traditional term or whole life coverage, while others may consider
            guaranteed issue or no-medical-exam products designed for eligibility
            regardless of health history.
          </p>
          <a class="fe-spotlight__link" href="/senior-life-insurance/">Learn about senior life insurance →</a>
        </div>
      </div>

      <p class="fe-spotlight__cross-link">
        Looking specifically for final expense coverage?
        <a href={RELATED_SITES.finalExpense.url}>Learn more about Florida final expense insurance at {RELATED_SITES.finalExpense.name} →</a>
      </p>
    </div>
  </section>

  <!-- WHY CHOOSE US / TRUST -->
  <section class="section section--cloud">
    <div class="container">
      <SectionHeading
        eyebrow="Why Florida Life Insurance"
        title="A modern way to shop for coverage"
      />
      <div style="margin-top: var(--space-8);">
        <TrustSection points={trustPoints} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHeading eyebrow="FAQ" title="Common questions about life insurance in Florida" />
      <div style="margin-top: var(--space-7);">
        <FAQ items={homepageFaq} />
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <CTA />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--space-10);
    padding-bottom: var(--space-9);
  }

  .hero__wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 140px;
    z-index: -1;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-9);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .hero__copy {
    max-width: 560px;
  }

  .hero h1 {
    margin-top: var(--space-4);
  }

  .hero .lead {
    margin-top: var(--space-4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  /* Quote flow mockup — CSS-built, not a photo */
  .quote-mock {
    justify-self: center;
    width: 100%;
    max-width: 380px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
    display: none;
  }

  @media (min-width: 640px) {
    .quote-mock {
      display: block;
    }
  }

  .quote-mock__header {
    display: flex;
    gap: 6px;
    margin-bottom: var(--space-5);
  }

  .quote-mock__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .quote-mock__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: var(--color-cloud);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .quote-mock__row {
    display: flex;
    gap: var(--space-3);
  }

  .quote-mock__field--half {
    flex: 1;
  }

  .quote-mock__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .quote-mock__value {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink);
  }

  .quote-mock__cta {
    margin-top: var(--space-4);
    text-align: center;
    background: var(--color-coral);
    color: var(--color-white);
    font-weight: 600;
    font-size: var(--fs-small);
    padding: var(--space-3);
    border-radius: var(--radius-full);
  }

  .quote-mock__footnote {
    text-align: center;
    margin-top: var(--space-3);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .quote-disclosure {
    max-width: none;
    margin-top: var(--space-5);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* Final expense spotlight */
  .fe-spotlight__grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  @media (min-width: 800px) {
    .fe-spotlight__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .fe-spotlight__card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .fe-spotlight__card h3 {
    margin-bottom: var(--space-3);
  }

  .fe-spotlight__card p {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    max-width: none;
  }

  .fe-spotlight__link {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--color-teal-dark);
  }

  .fe-spotlight__link:hover {
    color: var(--color-teal);
  }

  .fe-spotlight__cross-link {
    margin-top: var(--space-7);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    max-width: none;
  }

  .fe-spotlight__cross-link a {
    font-weight: 600;
    color: var(--color-teal-dark);
  }

  .fe-spotlight__cross-link a:hover {
    color: var(--color-teal);
  }
</style>
