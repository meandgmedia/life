---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Insurance Disclosures"
  description="Licensing, product availability, and compensation disclosures for Florida Life Insurance."
  path="/disclosures/"
>
  <section class="section--tight section">
    <div class="container container--narrow">
      <span class="eyebrow">Legal</span>
      <h1 style="margin-top: var(--space-4);">Insurance Disclosures</h1>
      <p class="lead" style="margin-top: var(--space-4);">Effective Date: August 21, 2026</p>

      <div class="prose">
        <h2>Licensing</h2>
        <p>
          {SITE.name} is operated by {SITE.agentName}, a licensed
          insurance agent in the state of Florida ({SITE.agentLicense}).
          {SITE.agentName} is appointed to offer life insurance products
          from a range of carriers, subject to each carrier's own
          appointment and underwriting requirements.
        </p>

        <h2>Product Availability</h2>
        <p>
          Not every product referenced on this Site is available in every
          situation. Product availability, coverage amounts, features, and
          pricing vary by insurance carrier and are subject to the
          applicant's eligibility and the carrier's underwriting
          requirements.
        </p>

        <h2>No Guarantee of Approval</h2>
        <p>
          Requesting a quote through this Site does not guarantee approval
          for coverage. Some policies — including many simplified issue and
          guaranteed issue products — may be issued relatively quickly
          depending on eligibility and carrier underwriting. Others,
          particularly larger fully underwritten policies, may require
          additional review, including a medical exam.
        </p>

        <h2>How Quotes and Applications Work</h2>
        <p>
          Quotes and applications on this Site are powered by BackNine's
          "Strife" quote and application platform, which connects you to
          available carriers and products based on the information you
          provide. Estimated options shown are not a binding offer of
          coverage; final terms are determined by the applicable carrier
          during underwriting.
        </p>

        <h2>Compensation Disclosure</h2>
        <p>
          As a licensed insurance agent, {SITE.agentName} may receive
          compensation, such as commissions, from insurance carriers for
          policies placed through this Site. This does not change the
          price you pay for coverage.
        </p>

        <h2>State Availability</h2>
        <p>
          This website is currently focused on insurance products available
          to Florida residents.
        </p>

        <h2>No Government Affiliation</h2>
        <p>
          This website is not affiliated with or endorsed by any government
          agency, including Medicare or the Social Security Administration.
        </p>

        <h2>Questions</h2>
        <p>
          For questions about a specific product, license, or disclosure,
          contact us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>,
          by phone at <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>, or
          through our <a href="/contact/">contact page</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    margin-top: var(--space-8);
    max-width: 68ch;
  }

  .prose h2 {
    margin-top: var(--space-8);
    font-size: var(--fs-h3);
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .prose a {
    color: var(--color-teal-dark);
    font-weight: 600;
  }

  .prose a:hover {
    color: var(--color-teal);
  }
</style>
